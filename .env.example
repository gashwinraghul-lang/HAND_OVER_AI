# ==========================================
# HandOver.AI Configuration Template
# Copy to .env (or export these variables) before running.
# ==========================================

# Server Port
SERVER_PORT=8080

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Default demo mode uses the embedded H2 file database, so no MySQL is
# required. To use MySQL 8 (docker compose up -d), uncomment the block
# below and remove/ignore the H2 defaults.
# ------------------------------------------------------------------
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/handover_ai?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
# SPRING_DATASOURCE_USERNAME=handover_user
# SPRING_DATASOURCE_PASSWORD=handover_pass
# SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect
# SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ------------------------------------------------------------------
# AI Configuration
# ------------------------------------------------------------------
# true = fully offline, deterministic demo answers with citations.
# false = live provider (requires a real LLM_API_KEY).
MOCK_AI_MODE=true
LLM_API_KEY=your_llm_api_key_here
LLM_API_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o

# ------------------------------------------------------------------
# Security & Data Encryption
# ------------------------------------------------------------------
# AES-GCM-256 key used for connector API keys and face embeddings.
# Use a 32-byte random value in production. Never commit the real key.
APP_ENCRYPTION_KEY=change-me-to-a-32-byte-random-secret
SESSION_TIMEOUT_MINUTES=60
SESSION_COOKIE_SECURE=false
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Face login can be disabled entirely on machines without a camera.
FACE_LOGIN_ENABLED=true

# ------------------------------------------------------------------
# File Storage
# ------------------------------------------------------------------
UPLOAD_DIR=./uploads
